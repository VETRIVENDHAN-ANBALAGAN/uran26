# =================================================================
# URAN’26 PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================

# 1. Organizer Admin Passcode
# Used by PMIST organizers to access /admin command center & check-in APIs
ADMIN_SECRET_KEY=uran26_pmist_organizer_secret_key_change_in_production

# 2. Audit Logging Salt
# Used to compute one-way SHA-256 hashes of client IP addresses for privacy
AUDIT_SALT=uran26_audit_security_salt_2026_change_in_production

# 3. SMTP Email Dispatcher (Nodemailer)
# Configure these with your email delivery provider (Gmail App Pass, Resend, SendGrid, SES)
# If left unset, the backend runs in resilient SIMULATION mode (logs to server console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=join.uran26@gmail.com
SMTP_PASS=your_gmail_app_specific_password_here
SMTP_FROM="URAN’26 Hackathon" <join.uran26@gmail.com>

# 4. Optional Cloud Database (If deploying to Serverless like Vercel)
# DATABASE_URL=postgresql://user:password@host:5432/uran26
