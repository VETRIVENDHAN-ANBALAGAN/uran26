# =================================================================
# URAN’26 PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================

# 1. MongoDB Database Connection (Atlas or Self-Hosted)
# Paste your MongoDB connection string with credentials here:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/uran26?retryWrites=true&w=majority
MONGODB_DB=uran26

# 2. Organizer Admin Portal Login Credentials
# Used to log into the /admin organizer command center
ADMIN_USERNAME=admin
ADMIN_PASSWORD=uran26@admin
ADMIN_SECRET_KEY=uran26_pmist_organizer_secret_key_change_in_production
ADMIN_AUTH_SECRET=uran26_pmist_secure_session_salt_2026

# 3. Audit Logging Salt
# Used to compute one-way SHA-256 hashes of client IP addresses for privacy
AUDIT_SALT=uran26_audit_security_salt_2026_change_in_production

# 4. SMTP Email Dispatcher (Nodemailer)
# Configure these with your email delivery provider (Gmail App Pass, Resend, SendGrid, SES)
# If left unset, the backend runs in resilient SIMULATION mode (logs to server console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=join.uran26@gmail.com
SMTP_PASS=your_gmail_app_specific_password_here
SMTP_FROM="URAN’26 Hackathon" <join.uran26@gmail.com>

# 5. Optional Cloud KV / Redis (If using Vercel KV / Upstash)
# UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here
